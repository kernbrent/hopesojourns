{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hope-sojourns-interest",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "env": {
    "test": {
      "workers_dev": true,
      "preview_urls": true,
      "secrets": {
        "required": [
          "ADMIN_PASSWORD",
          "ADMIN_SESSION_SECRET"
        ]
      },
      "routes": [
        {
          "pattern": "test.hopesojourns.com/api/interest",
          "zone_name": "hopesojourns.com"
        },
        {
          "pattern": "test.hopesojourns.com/api/interest/*",
          "zone_name": "hopesojourns.com"
        }
      ],
      "vars": {
        "ENVIRONMENT": "test",
        "SHARED_SIGNIN": "disabled",
        "ALLOWED_ORIGINS": "https://test.hopesojourns.com,https://hopesojourns-test.pages.dev,http://localhost:*,http://127.0.0.1:*",
        "EMAIL_DELIVERY_MODE": "capture",
        "EMAIL_FROM_ADDRESS": "admin@hopesojourns.com",
        "EMAIL_REPLY_TO": "admin@hopesojourns.com",
        "MMT_EMAIL_DELIVERY_MODE": "capture",
        "HS_PORTAL_ORIGIN": "https://test.hopesojourns.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hope-sojourns-forms-test-copy-20260923",
          "database_id": "35fd6f33-1c36-4f62-8509-af68647366a2",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "RECEIPTS",
          "bucket_name": "hope-sojourns-receipts-test-copy-20260923"
        },
        {
          "binding": "GUIDES",
          "bucket_name": "hope-sojourns-guides-test"
        }
      ],
      "services": []
    },
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "secrets": {
        "required": [
          "ADMIN_PASSWORD",
          "ADMIN_SESSION_SECRET",
          "CSM_DISTRIBUTION_SECRET"
        ]
      },
      "routes": [
        {
          "pattern": "hopesojourns.com/api/interest",
          "zone_name": "hopesojourns.com"
        },
        {
          "pattern": "hopesojourns.com/api/interest/*",
          "zone_name": "hopesojourns.com"
        },
        {
          "pattern": "www.hopesojourns.com/api/interest",
          "zone_name": "hopesojourns.com"
        },
        {
          "pattern": "www.hopesojourns.com/api/interest/*",
          "zone_name": "hopesojourns.com"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SHARED_SIGNIN": "enabled",
        "MMT_EMAIL_PROVIDER": "resend",
        "MMT_EMAIL_DELIVERY_MODE": "live",
        "ALLOWED_ORIGINS": "https://hopesojourns.com,https://www.hopesojourns.com,https://hopesojourns.pages.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hope-sojourns-forms-production",
          "database_id": "d277a0d4-a471-43c6-8bcf-81524d08cd12",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "RECEIPTS",
          "bucket_name": "hope-sojourns-receipts-production"
        },
        {
          "binding": "GUIDES",
          "bucket_name": "hope-sojourns-guides-production"
        }
      ],
      "services": [
        {
          "binding": "CSM_STATUS",
          "service": "christian-steps-admin-api"
        }
      ]
    }
  }
}
