{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hope-sojourns-interest-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "test.hopesojourns.com/api/interest/*",
      "zone_name": "hopesojourns.com"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "vars": {
    "ENVIRONMENT": "test",
    "ALLOWED_ORIGINS": "https://test.hopesojourns.com,https://hopesojourns-test.pages.dev,http://localhost:*,http://127.0.0.1:*"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hope-sojourns-forms-test",
      "database_id": "3b9a972b-6295-4736-80eb-4c0169ec31bb",
      "migrations_dir": "migrations"
    }
  ]
}
